{
  "name_zh": "恆淨之軀",
  "name_ja": "クリアボディ",
  "name_en": "Clear Body",
  "basic_info": [
    "可以被交換",
    "可以被其他特性覆蓋",
    "可以被其他寶可夢複製",
    "受無特性狀態影響",
    "受破格或類似效果的影響",
