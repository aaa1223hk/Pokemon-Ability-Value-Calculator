{
  "name_zh": "古代活性",
  "name_ja": "こだいかっせい",
  "name_en": "Protosynthesis",
  "basic_info": [
    "不能被交換",
    "可以被其他特性覆蓋",
    "不能被其他寶可夢複製",
    "受無特性狀態影響",
    "變身時特性無效",
    "不在入場時發動"
