{
  "name_zh": "夸克充能",
  "name_ja": "クォークチャージ",
  "name_en": "Quark Drive",
  "basic_info": [
    "不能被交換",
    "可以被其他特性覆蓋",
    "不能被其他寶可夢複製",
    "受無特性狀態影響",
