      "origin": "同英文名。"
    },
    {
      "language": "西班牙文",
      "name": "Tinkaton",
      "origin": "同英文名。"
    },
    {
      "language": "韓文",
      "name": "두드리짱 Dudeurijjang",
      "origin": "來自“두드리다”（敲打）和“대장장이”（鐵匠）。"
    }
  ],
