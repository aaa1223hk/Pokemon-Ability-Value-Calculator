      "name": "第八世代",
      "versions": [
        {
          "name": "傳說 阿爾宙斯",
          "group": "寶可夢傳說 阿爾宙斯",
          "text": "在溯河而上的旅程中半途喪命的夥伴的靈魂纏繞其身。在流經洗翠地區的河川裡可謂所向無敵。"
        }
      ]
    },
    {
      "name": "第九世代",
      "versions": [
        {
          "name": "朱",
          "group": "寶可夢 朱／紫",
          "text": "在前往出生的河川的艱苦旅程中喪命的夥伴的靈魂時刻纏繞在它的身上。（雄性的樣子）纏繞在身上的夥伴們的靈魂化為了推進力，能若無其事地在激流中游泳。（雌性的樣子）"
        },
        {
          "name": "紫",
          "group": "寶可夢 朱／紫",
