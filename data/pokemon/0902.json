      "name": "Basculegion",
      "origin": "同英文名。"
    },
    {
      "language": "西班牙文",
      "name": "Basculegion",
      "origin": "同英文名。"
    },
    {
      "language": "韓文",
      "name": "대쓰여너 Daesseuyeoneo",
      "origin": "來自“대〈大〉”（大）、英文 bass（鱸魚）和“연어〈鰱魚〉”（鮭魚）。"
    }
