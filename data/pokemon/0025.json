  "pokedex_entries": [
    {
      "name": "第一世代",
      "versions": [
        {
          "name": "紅",
          "group": "寶可夢 紅／綠／藍",
          "text": "臉頰兩邊有著小小的電力袋。遇到危險時就會放電。"
        },
        {
          "name": "綠",
          "group": "寶可夢 紅／綠／藍",
          "text": "臉頰兩邊有著小小的電力袋。遇到危險時就會放電。"
        },
        {
          "name": "藍",
          "group": "寶可夢 紅／綠／藍",
          "text": "據說當好幾只聚在一起時，那裡就會凝聚強烈的電力，還可能會落下閃電。"
        },
        {
          "name": "皮卡丘",
          "group": "寶可夢 皮卡丘",
          "text": "會將尾巴豎起來，去感覺周圍是否安全。所以，如果隨便去拉它的尾巴，會被咬喔。"
        }
      ]
    },
    {
      "name": "第二世代",
      "versions": [
        {
          "name": "金",
          "group": "寶可夢 金／銀",
          "text": "擁有將生硬的果實，用電擊烤軟後再吃的生存智慧。"
        },
        {
          "name": "銀",
          "group": "寶可夢 金／銀",
          "text": "豎起尾巴探察周圍的情況時，偶爾會有雷電落到它的尾巴上。"
        },
        {
          "name": "水晶版",
          "group": "寶可夢 水晶版",
          "text": "兩頰上有儲存電力的囊袋。一旦生氣就會把儲存的電力一口氣釋放出來。"
        }
      ]
    },
    {
      "name": "第三世代",
      "versions": [
        {
          "name": "紅寶石",
          "group": "寶可夢 紅寶石／藍寶石",
          "text": "會用電去電擊它第一次看到的東西。如果有燒焦的樹果落下，那就是它搞錯了電擊強度的證明哦。"
        },
        {
          "name": "藍寶石",
          "group": "寶可夢 紅寶石／藍寶石",
          "text": "兩頰電力袋裡的電力好像是在它夜晚睡著的時候儲存起來的哦。有時也會睡糊塗了把電放光。"
        },
        {
          "name": "綠寶石",
          "group": "寶可夢 綠寶石",
          "text": "能將電力儲存在臉頰上的電力袋裡。只要一鼓作氣放電的話，就能放出足以招來閃電的電力。"
        },
        {
