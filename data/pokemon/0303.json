  "pokedex_entries": [
    {
      "name": "第三世代",
      "versions": [
        {
          "name": "紅寶石",
          "group": "寶可夢 紅寶石／藍寶石",
          "text": "鋼角變化成了一張大顎。如果因為它溫順的長相而大意的話，就會被它突然轉過來的大顎咬住。"
        },
        {
          "name": "藍寶石",
          "group": "寶可夢 紅寶石／藍寶石",
          "text": "讓對手大意後會用大顎去咬對手。被它可愛的長相騙到的話可是很危險的哦。那鋼顎其實是由角變化而來的。"
        },
        {
          "name": "綠寶石",
          "group": "寶可夢 綠寶石",
          "text": "巨大的下顎是由鋼質的角變形而成。對於因它可愛動作而一時大意的對手會以巨大的下顎一口咬住。"
        },
        {
          "name": "火紅",
          "group": "寶可夢 火紅／葉綠",
          "text": "會用溫順的長相讓對手大意，然後再用大顎一口咬住對手。咬住後就絕不會鬆口。"
        },
