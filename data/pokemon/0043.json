    {
      "name": "第一世代",
      "versions": [
        {
          "name": "紅",
          "group": "寶可夢 紅／綠／藍",
          "text": "別名謎行草。據說到了晚上，會用２條根走上長達３００米的距離。"
        },
        {
          "name": "綠",
          "group": "寶可夢 紅／綠／藍",
          "text": "別名謎行草。據說到了晚上，會用２條根走上長達３００米的距離。"
        },
        {
          "name": "藍",
          "group": "寶可夢 紅／綠／藍",
          "text": "白天它的臉保持在地下。晚上，它四處播種。"
        },
        {
          "name": "皮卡丘",
          "group": "寶可夢 皮卡丘",
          "text": "要是以為它是普通的草而將它拔起，就會聽到它的叫聲。這讓人感到莫名的恐怖。"
        }
      ]
