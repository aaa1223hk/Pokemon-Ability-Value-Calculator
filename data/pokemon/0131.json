  "pokedex_entries": [
    {
      "name": "第一世代",
      "versions": [
        {
          "name": "紅",
          "group": "寶可夢 紅／綠／藍",
          "text": "有著可以理解人類語言的高智商。喜歡乘載著人在海上前行。"
        },
        {
          "name": "綠",
          "group": "寶可夢 紅／綠／藍",
          "text": "有著可以理解人類語言的高智商。喜歡乘載著人在海上前行。"
        },
        {
          "name": "藍",
          "group": "寶可夢 紅／綠／藍",
          "text": "這種寶可夢被過渡獵殺而瀕臨絕種。它可以運送人們渡水。"
        },
        {
          "name": "皮卡丘",
          "group": "寶可夢 皮卡丘",
          "text": "它擁有可以理解人類語言的溫柔之心。會把人載在背上渡過大海。"
        }
      ]
    },
    {
