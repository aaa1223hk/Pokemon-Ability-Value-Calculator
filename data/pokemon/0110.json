          "text": "靠吃垃圾產生的瓦斯成長。在極罕見的狀況下可以發現三胞胎雙彈瓦斯。"
        },
        {
          "name": "白",
          "group": "寶可夢 黑／白",
          "text": "靠吃垃圾產生的瓦斯成長。在極罕見的狀況下可以發現三胞胎雙彈瓦斯。"
        }
      ]
    },
    {
      "name": "第六世代",
      "versions": [
        {
          "name": "Ｘ",
          "group": "寶可夢 Ｘ／Ｙ",
          "text": "這是一方膨脹另一方就會收縮的雙胞胎瓦斯彈。它一直在體內混合著毒瓦斯。"
        },
        {
          "name": "Ｙ",
          "group": "寶可夢 Ｘ／Ｙ",
          "text": "有時會因為非常罕見的突變，出現２個連線在一起的雙胞胎小瓦斯彈。"
        },
        {
          "name": "歐米伽紅寶石",
          "group": "寶可夢 歐米伽紅寶石／阿爾法藍寶石",
          "text": "非常喜歡腐爛的溼垃圾所產生的瓦斯。會定居在不打掃衛生的人家中，並在夜深人靜時去垃圾箱中尋找瓦斯。"
        },
        {
          "name": "阿爾法藍寶石",
          "group": "寶可夢 歐米伽紅寶石／阿爾法藍寶石",
          "text": "會透過讓雙胞胎之身依次收縮膨脹來混合毒瓦斯。越混合毒素就會越強越臭。"
        }
      ]
    },
    {
      "name": "第七世代",
      "versions": [
        {
          "name": "Let's Go! 皮卡丘",
          "group": "精靈寶可夢 Let's Go! 皮卡丘／Let's Go! 伊布",
          "text": "它要靠吸收垃圾裡的毒氣、細菌和灰塵來維持生命。"
        },
        {
          "name": "Let's Go! 伊布",
          "group": "精靈寶可夢 Let's Go! 皮卡丘／Let's Go! 伊布",
          "text": "它要靠吸收垃圾裡的毒氣、細菌和灰塵來維持生命。"
        }
      ]
    },
    {
      "name": "第八世代",
      "versions": [
        {
          "name": "劍",
          "group": "寶可夢 劍／盾",
          "text": "用２個身體來混合瓦斯。在往昔的伽勒爾似乎到處都能見到它們的身影。會吸收大氣中的汙染成分，然後吐出新鮮的空氣，這就是它的排洩方式。（伽勒爾的樣子）"
        },
        {
          "name": "盾",
          "group": "寶可夢 劍／盾",
          "text": "雖然吸入空氣的力量稍弱於伽勒爾的雙彈瓦斯，製造出的毒素卻更加強力。在往昔工廠林立，空氣嚴重汙染的時代，雙彈瓦斯不知道為什麼變成了這個樣子。（伽勒爾的樣子）"
        },
        {
          "name": "晶燦鑽石",
          "group": "寶可夢 晶燦鑽石／明亮珍珠",
          "text": "靠吃垃圾產生的瓦斯成長。在極罕見的狀況下可以發現三胞胎雙彈瓦斯。"
        },
        {
          "name": "明亮珍珠",
          "group": "寶可夢 晶燦鑽石／明亮珍珠",
          "text": "靠吃垃圾產生的瓦斯成長。在極罕見的狀況下可以發現三胞胎雙彈瓦斯。"
        }
      ]
    },
    {
      "name": "第九世代",
      "versions": [
        {
          "name": "朱",
          "group": "寶可夢 朱／紫",
          "text": "將它體內所含的毒瓦斯稀釋到極限，就能做出最高階的香水。"
        },
        {
          "name": "紫",
          "group": "寶可夢 朱／紫",
          "text": "每當它吸收從垃圾產生的毒瓦斯時，身體就會膨脹，體內的味道也會變得更臭。"
        }
      ]
    }
  ],
