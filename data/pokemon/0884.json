  "pokedex_entries": [
    {
      "name": "第八世代",
      "versions": [
        {
          "name": "劍",
          "group": "寶可夢 劍／盾",
          "text": "身體猶如打磨過的金屬，雖然輕而堅硬，卻有著容易生鏽的弱點。變得如同摩天大樓般高大。受到體內能量溢位的影響，身體的一部分會發出亮光。（超極巨化）"
        },
        {
          "name": "盾",
          "group": "寶可夢 劍／盾",
          "text": "由特殊金屬構成的身體十分輕盈，能夠靈活地活動。不喜歡下雨，所以住在洞窟裡。細胞的硬度在鋼屬性寶可夢之中也是頂級的。擁有抗震的構造。（超極巨化）"
        }
      ]
    },
    {
      "name": "第九世代",
      "versions": [
        {
          "name": "朱",
          "group": "寶可夢 朱／紫",
          "text": "由特殊金屬構成的身體如經過鏡面加工般光滑，不易受損且重量輕。"
        },
        {
          "name": "紫",
          "group": "寶可夢 朱／紫",
          "text": "金屬的身體雖然堅固，但由於會封閉熱量，因此會從尾巴縫隙排熱。"
        }
      ]
    }
  ],
