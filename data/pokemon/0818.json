      "name": "第八世代",
      "versions": [
        {
          "name": "劍",
          "group": "寶可夢 劍／盾",
          "text": "身上隱藏著多種特殊能力，例如從手指噴射水流，以及用背部的翼膜滑翔等等。水槍的速度達到了７馬赫。能夠一邊透過頭上的冠感知風和氣溫，一邊鎖定目標。（超極巨化）"
        },
        {
          "name": "盾",
          "group": "寶可夢 劍／盾",
          "text": "能從指尖射出速度高達３馬赫的水槍。它的瞬膜能幫助它看穿敵人的弱點，準確地擊中要害。狙擊技巧超群。打穿掉落在１５公里以外地面上的樹果對它來說也是小菜一碟。（超極巨化）"
        }
      ]
    },
    {
      "name": "第九世代",
      "versions": [
        {
          "name": "朱",
          "group": "寶可夢 朱／紫",
          "text": "能用眼睛的特殊晶狀體感知對手的體溫等資訊，並在看穿其要害後進行攻擊。"
        },
        {
          "name": "紫",
          "group": "寶可夢 朱／紫",
          "text": "雖然表現得很有紳士風度，但它的本性仍然很懶惰，沒有訓練家盯著就會偷懶。"
        }
      ]
    }
