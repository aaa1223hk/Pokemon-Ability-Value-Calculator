  "pokedex_entries": [
    {
      "name": "第八世代",
      "versions": [
        {
          "name": "劍",
          "group": "寶可夢 劍／盾",
          "text": "總是餓著肚子。會吃掉裝在像口袋一樣的袋子裡的種子來發電。（滿腹花紋）頰囊中的電能轉化成了惡屬性的能量。因為肚子餓扁了，所以非常兇暴。（空腹花紋）"
        },
        {
          "name": "盾",
          "group": "寶可夢 劍／盾",
          "text": "無論怎麼吃都會馬上肚子餓。十分珍愛自己用電烘烤過的種子，隨時都帶在身上。（滿腹花紋）飢餓荷爾蒙改變了它的性情。它會做盡一切的壞事，直到把肚子填飽為止。（空腹花紋）"
        }
      ]
    },
    {
      "name": "第九世代",
      "versions": [
        {
          "name": "朱",
          "group": "寶可夢 朱／紫",
          "text": "雖然總是在靠吃種子來抑制飢餓感，但若是餓過頭，就會心煩意亂變得粗暴。（滿腹花紋）性情兇惡又粗暴的傢伙。即使用光了惡能量，也會大鬧到填飽肚子為止。（空腹花紋）"
        },
        {
          "name": "紫",
          "group": "寶可夢 朱／紫",
          "text": "胃很小，所以不常吃袋子裡的種子的話，肚子馬上就會餓。（滿腹花紋）因飢餓導致荷爾蒙失衡，使頰囊中的電能轉化成了惡屬性的能量。（空腹花紋）"
        },
        {
          "name": "傳說 Z-A",
          "group": "寶可夢傳說 Z-A",
          "text": "總是餓著肚子。會吃掉裝在像口袋一樣的袋子裡的種子來發電。（滿腹花紋）頰囊中的電能轉化成了惡屬性的能量。因為肚子餓扁了，所以非常兇暴。（空腹花紋）"
        }
      ]
    }
