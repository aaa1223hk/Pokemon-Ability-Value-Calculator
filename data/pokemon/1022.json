{
  "name_zh": "鐵磐巖",
  "name_ja": "テツノイワオ",
  "name_en": "Iron Boulder",
  "pokedex_id": "1022",
  "description": "鐵磐巖（日文︰テツノイワオ，英文︰Iron Boulder）是岩石屬性／超能力屬性悖謬寶可夢。",
  "profile": "被認為是金屬質地的身體是這種寶可夢的特徵。長在頭上的角的發光部分形狀大變，就像是左右相連的圓形刃器。它與可疑的雜誌中提到的由邪惡組織改造代拉基翁而成的寶可夢很相似，而真相並沒有定論。\n它的名字來自古書中所記載的神秘物體。",
  "prototype": "鐵磐巖在代拉基翁的基礎上融入了機械的要素。攻擊時變形的角可能參考了工兵鏟。",
  "detail": "鐵磐巖、鐵斑葉與鐵頭殼的部分要素與在《紫之書》上刊登的素描相似。",
  "names": [
    {
      "language": "日文",
      "name": "テツノイワオ Tetsunoiwao",
      "origin": "來自“鉄（てつ）の巌（いわお）”（鐵的磐石）。"
    },
    {
      "language": "中文-任天堂",
      "name": "鐵磐巖鐵磐巖",
      "origin": "來自“鐵”、“磐石”和“岩石”。"
    },
    {
      "language": "英文",
      "name": "Iron Boulder",
      "origin": "來自 iron（鐵）和 boulder（巨石）。"
    },
    {
      "language": "法文",
      "name": "Roc-de-Fer",
      "origin": "來自 roc（岩石）和 de fer（鐵的）。"
    },
    {
      "language": "德文",
      "name": "Eisenfels",
      "origin": "來自 Eisen（鐵）和 Fels（岩石）。"
    },
    {
      "language": "義大利文",
      "name": "Massoferreo",
      "origin": "來自 masso（岩石）和 ferreo（鐵的）。"
    },
    {
      "language": "西班牙文",
      "name": "Ferromole",
      "origin": "來自字首 ferro-（表示“鐵”）和 mole（大塊）。"
    },
    {
      "language": "韓文",
      "name": "무쇠암석 Musoeamseok",
      "origin": "來自“무쇠”（鑄鐵）和“암석〈岩石〉”（岩石）。"
    }
