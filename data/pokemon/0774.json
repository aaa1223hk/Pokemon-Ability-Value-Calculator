  "pokedex_entries": [
    {
      "name": "第七世代",
      "versions": [
        {
          "name": "太陽",
          "group": "精靈寶可夢 太陽／月亮",
          "text": "原本棲息在臭氧層，身體的外殼變重後，就會向著地面落下。（流星的樣子）吃大氣中的塵埃。根據吃下的塵埃的成分，來決定核心的色調。（核心）"
        },
        {
          "name": "月亮",
          "group": "精靈寶可夢 太陽／月亮",
          "text": "如果受到強烈的衝擊，外殼就會剝落。奈米粒子突變誕生而成的寶可夢。（流星的樣子）核心如果一直暴露著，就會很快消散。聽說如果趕緊放入精靈球，就能活下來。（核心）"
        }
      ]
    },
    {
      "name": "第九世代",
      "versions": [
        {
          "name": "朱",
          "group": "寶可夢 朱／紫",
          "text": "誕生於臭氧層的寶可夢。當包裹核心的外殼變重了，就會掉落到地面上。（流星的樣子）掉落到地上的小隕星雖然會試圖回到宇宙，但卻無法如願，只能逐漸消逝。（核心）"
        },
        {
          "name": "紫",
          "group": "寶可夢 朱／紫",
          "text": "摸它叫它，它都會作出些什麼反應，但並不清楚這些反應是否出自它自身的意志。（流星的樣子）以大氣中的塵埃為食物。據說核心的顏色是根據塵埃含有的成分而定。（核心）"
        }
      ]
    }
  ],
