  "pokedex_entries": [
    {
      "name": "第七世代",
      "versions": [
        {
          "name": "太陽",
          "group": "精靈寶可夢 太陽／月亮",
          "text": "正身不明。某位學者看過破布裡面後，因為太過恐懼而被驚嚇致死。（化形的樣子）好不容易喬裝打扮，脖子卻折了。本體基本上還是好好的，但看著還是感覺很悲慘。（現形的樣子）"
        },
        {
          "name": "月亮",
          "group": "精靈寶可夢 太陽／月亮",
          "text": "這個怕寂寞的傢伙，會用破布隱藏自己可怕的樣子來接近人和其他寶可夢。（化形的樣子）被攻擊後脖子折了，或是身上披的布破了的話，本體就會加夜班進行修繕。（現形的樣子）"
        }
      ]
    },
    {
      "name": "第八世代",
      "versions": [
        {
          "name": "劍",
          "group": "寶可夢 劍／盾",
          "text": "為了讓別人不要害怕自己，特意穿上了看似皮卡丘的破布，結果卻變得更加令人毛骨悚然。（化形的樣子）絕不會原諒揭穿自己化形成皮卡丘這件事的傢伙。即使犧牲自己也會將對方打倒。（現形的樣子）"
        },
        {
          "name": "盾",
          "group": "寶可夢 劍／盾",
          "text": "有一位學者為了研究而看了它的破布裡面，結果患上怪病而離開人世。（化形的樣子）雖然能用破布抵擋住敵人的攻擊，但折斷的脖子卻讓它現出原形。（現形的樣子）"
        }
      ]
    },
    {
      "name": "第九世代",
      "versions": [
        {
          "name": "朱",
          "group": "寶可夢 朱／紫",
          "text": "棲息在陽光照射不到的陰暗處。在人們面前現身時會用酷似皮卡丘的布來蓋住全身。（化形的樣子）一邊假裝自己是皮卡丘，一邊在布里掙扎著，試圖擺正折斷的脖子。（現形的樣子）"
        },
        {
          "name": "紫",
          "group": "寶可夢 朱／紫",
          "text": "最近才被認定為寶可夢。在這之前，大家一直以為它是穿著布的幽靈。（化形的樣子）受到傷害而無法再支撐起布料的頭。它一輩子都不會忘記攻擊了自己的對手。（現形的樣子）"
        },
        {
          "name": "傳說 Z-A",
          "group": "寶可夢傳說 Z-A",
          "text": "這個怕寂寞的傢伙，會用破布隱藏自己可怕的樣子來接近人和其他寶可夢。（化形的樣子）因正身就要暴露而很悲痛。絕不原諒折斷了它脖子的對手，會向對方報仇。（現形的樣子）"
        }
      ]
    }
  ],
