        {
          "name": "Let's Go! 皮卡丘",
          "group": "精靈寶可夢 Let's Go! 皮卡丘／Let's Go! 伊布",
          "text": "如果你突然感到寒氣逼近，就說明耿鬼在你身邊，或許它已經在你身上下了詛咒。能穿過異次元前往任何地方。當它從牆壁裡伸出一隻腳的時候，周圍的人都亂成了一團。（超級進化）"
        },
        {
          "name": "Let's Go! 伊布",
          "group": "精靈寶可夢 Let's Go! 皮卡丘／Let's Go! 伊布",
          "text": "如果你突然感到寒氣逼近，就說明耿鬼在你身邊，或許它已經在你身上下了詛咒。能穿過異次元前往任何地方。當它從牆壁裡伸出一隻腳的時候，周圍的人都亂成了一團。（超級進化）"
        }
      ]
    },
    {
      "name": "第八世代",
      "versions": [
        {
          "name": "劍",
          "group": "寶可夢 劍／盾",
          "text": "滿月的夜晚，如果影子自己動起來並露出笑容，那肯定是耿鬼搞的鬼。身體裡填滿了詛咒的能量。據說它巨大嘴巴的另一端連線著死後的世界。（超極巨化）"
        },
        {
          "name": "盾",
          "group": "寶可夢 劍／盾",
          "text": "據說它會為了奪取山中遇難者的生命而從黑暗中出現。會設下致命的陷阱。如果站在它的嘴巴前面，就會聽見心愛之人呼喚自己的聲音。（超極巨化）"
        },
        {
          "name": "晶燦鑽石",
          "group": "寶可夢 晶燦鑽石／明亮珍珠",
          "text": "會隱藏在物體的陰影裡。據說躲著耿鬼的房間溫度會下降５度。"
        },
        {
          "name": "明亮珍珠",
          "group": "寶可夢 晶燦鑽石／明亮珍珠",
          "text": "它會潛藏在房屋角落的陰暗處，悄悄地窺探著奪取性命的時機。"
        },
        {
          "name": "傳說 阿爾宙斯",
          "group": "寶可夢傳說 阿爾宙斯",
          "text": "附在影子裡伺機取人性命的寶可夢。要是發現腳下的影子自己在笑，最好趕緊握住護身符來驅邪。"
        }
      ]
    },
    {
      "name": "第九世代",
      "versions": [
        {
          "name": "朱",
          "group": "寶可夢 朱／紫",
          "text": "會藏進獵物的影子裡，然後悄悄地等待奪取性命的機會到來。"
        },
        {
          "name": "紫",
          "group": "寶可夢 朱／紫",
          "text": "會在半夜潛入人的影子，一點點地奪走人的體溫。如果被它盯上，就會全身不停地發冷。"
        },
        {
          "name": "傳說 Z-A",
          "group": "寶可夢傳說 Z-A",
          "text": "會隱藏在物體的陰影裡。據說躲著耿鬼的房間溫度會下降５度。能穿過異次元前往任何地方。當它從牆壁裡伸出一隻腳的時候，周圍的人都亂成了一團。（超級進化）"
        }
      ]
    }
