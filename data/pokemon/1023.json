{
  "name_zh": "鐵頭殼",
  "name_ja": "テツノカシラ",
  "name_en": "Iron Crown",
  "pokedex_id": "1023",
  "description": "鐵頭殼（日文︰テツノカシラ，英文︰Iron Crown）是鋼屬性和超能力屬性悖謬寶可夢。鐵頭殼在2023年8月8日正式公佈。",
  "profile": "鐵頭殼有著發出S形光芒的角，與超自然雜誌中介紹的名為勾帕路翁型最新兵器的神秘物體長得很相似。\n據說鐵頭殼曾經用獨特的角射出發光的刀刃砍斷了周圍的一切，但無其他資訊，身份不明。",
  "prototype": "鐵頭殼在勾帕路翁的基礎上融入了機械的要素。其使用招式時伸長並揮動S型雙角的動作可能參考了現實中雄鹿和雄性羚羊的打鬥行為。",
  "detail": "鐵頭殼、鐵斑葉與鐵磐巖的部分要素與在《紫之書》上刊登的素描相似。",
  "names": [
    {
      "language": "日文",
      "name": "テツノカシラ Tetsunokashira",
      "origin": "來自“鉄（てつ）の頭（かしら）”（鐵的頭；鐵的頭目）。"
    },
    {
      "language": "中文-任天堂",
      "name": "鐵頭殼鐵頭殼",
      "origin": "來自“鐵”和“頭”及“頭殼”。"
    },
    {
      "language": "英文",
      "name": "Iron Crown",
      "origin": "來自 iron（鐵）和 crown（王冠；頭頂）。"
    },
    {
      "language": "法文",
      "name": "Chef-de-Fer",
      "origin": "來自 chef（頭領）和 de fer（鐵的）。"
    },
    {
      "language": "德文",
      "name": "Eisenhaupt",
      "origin": "來自 Eisen（鐵）和 Haupt（頭；頭領）。"
    },
    {
      "language": "義大利文",
      "name": "Capoferreo",
      "origin": "來自 capo（頭；首領）和 ferreo（鐵的）。"
    },
    {
      "language": "西班牙文",
      "name": "Ferrotesta",
      "origin": "來自字首 ferro-（表示“鐵”）和 testa（頭）。"
    },
    {
      "language": "韓文",
      "name": "무쇠감투 Musoegamtu",
      "origin": "來自“무쇠”（鑄鐵）和“감투”（紗帽；官位）。"
    }
  ],
