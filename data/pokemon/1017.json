  "pokedex_entries": [
    {
      "name": "第九世代",
      "versions": [
        {
          "name": "朱",
          "group": "寶可夢 朱／紫",
          "text": "屬性根據身著的面具而改變。會以敏捷的身手和踢技將敵人玩弄於股掌之中。（碧草面具）這是它攻守兼備的樣子，會像不斷湧出的水一樣無間斷地使出招式。（水井面具）這是它最具攻擊性的樣子，能夠如爐中熊熊燃燒的火焰般猛烈攻擊敵人。（火灶面具）這是它防守優秀的樣子，能夠如支撐住家的地基般承受沉重的衝擊。（礎石面具）"
        },
        {
          "name": "紫",
          "group": "寶可夢 朱／紫",
          "text": "喜歡惡作劇，好奇心旺盛。會釋出蘊藏在面具內的屬性的能量戰鬥。（碧草面具）激發出水之力量的樣子。會以踢技和藤蔓發起無間斷的打擊。（水井面具）激發出火之力量的樣子。會像揮動長槍一樣操控帶刺的藤蔓貫穿敵人。（火灶面具）激發出岩石之力量的樣子。能以堅固的岩石身軀抵擋任何攻擊，守護自身。（礎石面具）"
        }
      ]
    }
  ],
