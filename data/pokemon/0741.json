  "pokedex_entries": [
    {
      "name": "第七世代",
      "versions": [
        {
          "name": "太陽",
          "group": "精靈寶可夢 太陽／月亮",
          "text": "拍打翅膀生火。一邊踩著華麗的步伐，一邊灑下猛烈的火焰。（熱辣熱辣風格）吸食了金黃色花蜜的花舞鳥。以明快歡樂的舞蹈讓敵人的身心都徹底釋放。（啪滋啪滋風格）搖搖擺擺地放鬆自己。這之後，將提高的精神力量瞄準敵人發射出去。（呼拉呼拉風格）吸食了蘭紫色花蜜的花舞鳥。用優雅華麗的舞蹈將敵人的身心都誘惑到異世界。（輕盈輕盈風格）"
        },
        {
          "name": "月亮",
          "group": "精靈寶可夢 太陽／月亮",
          "text": "吸食了硃紅色花蜜的花舞鳥。以熱情的步伐將敵人的身心全部燃燒殆盡。（熱辣熱辣風格）摩擦羽毛生電。像跳舞一樣接近敵人，施展出電擊拳。（啪滋啪滋風格）吸食了桃粉色花蜜的花舞鳥。穩健地擺動腰部，讓敵人的身心都融化。（呼拉呼拉風格）用充滿幻想的舞蹈召喚死者。藉助這股怨念的力量對敵人施加詛咒。（輕盈輕盈風格）"
        }
      ]
    },
    {
      "name": "第九世代",
      "versions": [
        {
          "name": "朱",
          "group": "寶可夢 朱／紫",
          "text": "熱情的舞蹈與帕底亞人們的性情似乎很合得來，因此非常受歡迎。（熱辣熱辣風格）吸食了金黃色花蜜的樣子。會以輕快的舞步靠近對手並用電擊拳頭將其KO。（啪滋啪滋風格）輕快的舞蹈有助於保持健康，也因此很受人們歡迎，但在帕底亞卻很少見。（呼拉呼拉風格）吸食了蘭紫色花蜜的樣子。會透過奇幻的舞步召喚出死者的靈魂。（輕盈輕盈風格）"
        },
        {
          "name": "紫",
          "group": "寶可夢 朱／紫",
          "text": "吸食了硃紅色花蜜的樣子。會踩著熱情的舞步，捲起猛烈的火焰。（熱辣熱辣風格）充滿活力與歡樂的舞蹈風格在孩子們當中很受歡迎，但在帕底亞卻很少見。（啪滋啪滋風格）吸食了桃粉色花蜜的樣子。會踏著緩慢的舞步來集中精神，然後釋放精神力量。（呼拉呼拉風格）美豔又高雅的舞蹈風格在大人們當中很受歡迎，但在帕底亞卻很少見。（輕盈輕盈風格）"
        }
      ]
    }
  ],
