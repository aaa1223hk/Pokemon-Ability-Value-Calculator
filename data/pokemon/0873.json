          "name": "劍",
          "group": "寶可夢 劍／盾",
          "text": "翅膀的溫度為零下１８０度。當它飛過山野時，帶有冷氣的鱗粉會像下雪般地飄落下來。"
        },
        {
          "name": "盾",
          "group": "寶可夢 劍／盾",
          "text": "絕不放過破壞山野環境的人。會用冰冷的翅膀四處飛翔，製造出暴風雪來懲罰他們。"
        }
      ]
    },
    {
      "name": "第九世代",
      "versions": [
        {
          "name": "朱",
          "group": "寶可夢 朱／紫",
          "text": "觸角能夠感知大氣的流動。會把冷氣混入鱗粉之中，然後如同降雪般地撒下。"
        },
        {
          "name": "紫",
          "group": "寶可夢 朱／紫",
          "text": "會用能釋放寒氣的巨大翅膀飛來飛去，引發暴風雪。喜歡乾淨的雪融水。"
        }
      ]
    }
