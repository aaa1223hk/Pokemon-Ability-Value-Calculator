    {
      "name": "第三世代",
      "versions": [
        {
          "name": "紅寶石",
          "group": "寶可夢 紅寶石／藍寶石",
          "text": "能非常敏銳地感知人心。一旦察覺到敵意，就會豎起全身羽毛，用激烈的叫聲威嚇對方。"
        },
        {
          "name": "藍寶石",
          "group": "寶可夢 紅寶石／藍寶石",
          "text": "智商很高，能理解人類的語言。會用玻璃般的羽毛包裹身體，令光發生折射來改變自己的樣子。"
        },
        {
          "name": "綠寶石",
          "group": "寶可夢 綠寶石",
          "text": "會有好幾只形成群體一起行動，很少與人類或寶可夢接觸。一旦察覺有敵人的動靜時就會消失無蹤。"
        },
