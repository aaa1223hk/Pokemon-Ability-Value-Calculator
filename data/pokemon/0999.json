    {
      "language": "英文",
      "name": "Gimmighoul",
      "origin": "來自口語 gimme（給我）和 ghoul（食屍鬼），諧音 gimme gold（給我金幣）。"
    },
    {
      "language": "法文",
      "name": "Mordudor",
      "origin": "來自 mort（死亡）和 or（金），諧音 mordu d'or（貪財如命者；拜金者）。"
