{
  "name_zh": "鐵斑葉",
  "name_ja": "テツノイサハ",
  "name_en": "Iron Leaves",
  "pokedex_id": "1010",
  "description": "鐵斑葉（日文︰テツノイサハ，英文︰Iron Leaves）是草屬性／超能力屬性悖謬寶可夢。",
  "profile": "鐵斑葉與刊登在《紫之書》上，由當時的第零區觀測隊所描繪的素描有相似之處，與超自然雜誌中介紹過的未來的畢力吉翁的樣子有多個特徵相吻合。它擁有光滑透亮，質感如金屬般的身體，額頭與頸部發光的部位似乎有時能變形成像長劍一樣。\n根據極少的目擊報告，鐵斑葉用散發著光輝的劍將大樹和大石頭切成了絲。",
  "prototype": "鐵斑葉在畢力吉翁的基礎上融入了機械的要素，比如仿生馬等動物機械。",
  "detail": "鐵斑葉、鐵磐巖與鐵頭殼的部分要素與在《紫之書》上刊登的素描相似。",
  "names": [
    {
      "language": "日文",
      "name": "テツノイサハ Tetsunoisaha",
      "origin": "來自“鉄（てつ）の斑（いさ）葉（は）”（鐵的斑葉）。"
    },
    {
      "language": "中文-任天堂",
      "name": "鐵斑葉鐵斑葉",
      "origin": "來自“鐵”和“斑葉”。"
    },
    {
      "language": "英文",
      "name": "Iron Leaves",
      "origin": "來自 iron（鐵）和 leaf（葉子）。"
    },
    {
      "language": "法文",
      "name": "Vert-de-Fer",
      "origin": "來自 vert（綠色）和 de fer（鐵的）。"
    },
    {
      "language": "德文",
      "name": "Eisenblatt",
      "origin": "來自 Eisen（鐵）和 Blatt（葉子）。"
    },
    {
      "language": "義大利文",
      "name": "Fogliaferrea",
      "origin": "來自 foglia（葉子）和 ferreo（鐵的）。"
    },
    {
