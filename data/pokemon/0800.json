  "pokedex_entries": [
    {
      "name": "第七世代",
      "versions": [
        {
          "name": "太陽",
          "group": "精靈寶可夢 太陽／月亮",
          "text": "好像一直都沉睡在地下。被認為是太古時代從其他世界來到此地的類似究極異獸的生物。"
        },
        {
          "name": "月亮",
          "group": "精靈寶可夢 太陽／月亮",
          "text": "光似乎是它的能量源。一個勁兒地發射鐳射，性格非常粗暴。"
        }
      ]
    },
    {
      "name": "第八世代",
      "versions": [
        {
          "name": "劍",
          "group": "寶可夢 劍／盾",
          "text": "光芒是它維持生命的能量。由於一直沉睡於地下，身體因積存在體內的雜質而發黑。支配著索爾迦雷歐的樣子。性格殘暴，會用背部與四肢的爪子將獵物大卸八塊。（黃昏之鬃）將露奈雅拉完全支配，強行讓它釋放出光能，並把光能吸收。（拂曉之翼）"
        },
        {
          "name": "盾",
          "group": "寶可夢 劍／盾",
          "text": "為生存而發狂般地尋找著光。會發射出鐳射，將所有東西切成碎片。附在索爾迦雷歐身上，強行吸取它無限湧出的能量，四處造成破壞。（黃昏之鬃）附在露奈雅拉身上的樣子。變得更加兇暴，將萬物視為敵人，會用鐳射燒盡一切。（拂曉之翼）"
        }
      ]
    }
  ],
